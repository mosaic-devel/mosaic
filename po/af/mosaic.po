#: src/ui/tool.cpp:272
msgid ""
"Rebuild the picture instead of cropping: the marked regions move closer "
"together, the background is retargeted and the gaps are healed. Available "
"when the marked regions cannot all fit a crop at this ratio"
msgstr ""
"Bou die prent oor in plaas van om te snoei: die gemerkte gebiede skuif nader "
"aan mekaar, die agtergrond word aangepas en die gapings word gehéél. "
"Beskikbaar wanneer die gemerkte gebiede nie almal in 'n snoei by hierdie "
"verhouding pas nie"

#: src/ui/tool.cpp:278
msgid "Free"
msgstr "Vry"

